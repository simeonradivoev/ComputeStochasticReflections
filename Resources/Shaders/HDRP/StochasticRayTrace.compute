#pragma kernel CSRaycast
#pragma kernel CSResolve
#pragma kernel CSTemporal

#define KERNEL_SIZE 16
#define SR_FLT_EPS 0.00000001

#include "Packages/com.simeonradivoev.stochastic-reflections/Resources/Shaders/HDRP/StochasticSSRCommon.hlsl"
#include "Packages/com.simeonradivoev.stochastic-reflections/Resources/Shaders/BRDFComputeLib.cginc"

// ---------------------------------------------------------------------------------------------
// Hierarchical Z ray marching
// ---------------------------------------------------------------------------------------------
float SR_ClampRay(float2 start, float2 end, float2 delta)
{
	float2 dir = abs(end - start);
	return length(float2(min(dir.x, delta.x), min(dir.y, delta.y)));
}

// Marches in (uv, deviceDepth) space. Returns the hit position in xy, the device depth of the hit
// in z and the intersection mask in w.
float4 SR_RayMarch(float3 viewDir, int numSteps, float3 viewPos, float3 screenPos, float2 uv, float thickness)
{
	// Project a point one unit along the ray to get the ray direction in screen space.
	float3 rayEnd = SR_GetUVAndDeviceDepthFromViewPosition(viewPos + viewDir);
	float3 delta = rayEnd - screenPos;

	// Normalize in the same space the original implementation used (NDC xy + device depth) and then
	// convert the xy components back to uv units.
	float3 rayDir = float3(delta.xy * 2.0, delta.z);
	rayDir /= max(1e-8, length(rayDir));
	rayDir.xy *= 0.5;

	float3 rayStart = float3(uv, screenPos.z);
	float2 screenDelta = _SR_RayCastSize.zw;
	float d = SR_ClampRay(rayStart.xy, rayStart.xy + rayDir.xy, screenDelta);
	float3 samplePos = rayStart + rayDir * d;
	int level = 0;
	float mask = 0.0;

	[loop]
	for (int i = 0; i < numSteps; i++)
	{
		float2 currentDelta = screenDelta * exp2(level + 1);
		float distance = SR_ClampRay(samplePos.xy, samplePos.xy + rayDir.xy, currentDelta);
		float3 nextSamplePos = samplePos + rayDir * distance;
		float sampleNearestDepth = SR_GetHZDepth(nextSamplePos.xy, level);
		float nextDepth = nextSamplePos.z;

		// The pyramid stores the nearest surface of the tile. The ray can advance while it is in front
		// of that surface: with reversed Z a closer surface has a larger raw depth.
#if UNITY_REVERSED_Z
		bool inFrontOfTile = sampleNearestDepth < nextDepth;
#else
		bool inFrontOfTile = sampleNearestDepth > nextDepth;
#endif
		[flatten]
		if (inFrontOfTile)
		{
			level = min(level + 1, 6);
			samplePos = nextSamplePos;
		}
		else
		{
			level--;
		}

		[branch]
		if (level < 0)
		{
			float depthDelta = (-LinearEyeDepth(sampleNearestDepth, _SRZBufferParams)) - (-LinearEyeDepth(samplePos.z, _SRZBufferParams));
			mask = (depthDelta <= thickness && i > 0) ? 1.0 : 0.0;

			return float4(samplePos, mask);
		}
	}

	return float4(samplePos, mask);
}

// ---------------------------------------------------------------------------------------------
// Raycast
// ---------------------------------------------------------------------------------------------
RWTexture2D<half4> _SRRayCast;
RWTexture2D<half> _SRRayCastMask;

[numthreads(KERNEL_SIZE, KERNEL_SIZE, 1)]
void CSRaycast(uint3 id : SV_DispatchThreadID)
{
	float2 uv = (id.xy + 0.5) * _SR_RayCastSize.zw;

	float4 normalAndRoughness = SR_GetNormalAndRoughness(uv);
	float3 viewNormal = SR_GetViewNormal(normalAndRoughness.xyz);
	float roughness = normalAndRoughness.w;

	float depth = SR_GetRawDepth(uv);
	float3 screenPos = float3(uv, depth);
	float3 viewPos = SR_GetViewPosition(uv, depth);

	// Blue noise generated by https://github.com/bartwronski/BlueNoiseGenerator/
	// Point sampling keeps the per pixel jitter crisp; a filtered lookup turns the jitter into a smooth
	// offset which makes the reflections drift from frame to frame.
	float2 jitter = _SRNoise.SampleLevel(sampler_point_repeat, (uv + _SRJitterSizeAndOffset.zw) * _SR_ScreenSize.xy * _SR_NoiseSize.zw, 0).xy;

	float2 Xi = jitter;
	Xi.y = lerp(Xi.y, 0.0, _SRBRDFBias);

	float4 H = TangentToWorld(viewNormal, ImportanceSampleGGX(Xi, roughness));
	float3 dir = reflect(normalize(viewPos), H.xyz);

	float4 rayTrace = SR_RayMarch(dir, _SRNumSteps, viewPos, screenPos, uv, _SRThickness);

	_SRRayCast[id.xy] = float4(rayTrace.xy, rayTrace.z, H.w);
	_SRRayCastMask[id.xy] = rayTrace.w;
}

// ---------------------------------------------------------------------------------------------
// Resolve
// ---------------------------------------------------------------------------------------------
#define RESOLVE_RAD 4
#define RESOLVE_RAD2 8

RWTexture2D<half4> _SRResolveResult;
Texture2D<half4> _SRRayCastInput;
Texture2D<half> _SRRayCastMaskInput;

groupshared uint rr_cacheR[(KERNEL_SIZE + RESOLVE_RAD2) * (KERNEL_SIZE + RESOLVE_RAD2)];
groupshared uint rr_cacheG[(KERNEL_SIZE + RESOLVE_RAD2) * (KERNEL_SIZE + RESOLVE_RAD2)];
groupshared uint rr_cacheB[(KERNEL_SIZE + RESOLVE_RAD2) * (KERNEL_SIZE + RESOLVE_RAD2)];
groupshared uint rr_cacheA[(KERNEL_SIZE + RESOLVE_RAD2) * (KERNEL_SIZE + RESOLVE_RAD2)];

void StoreResolveData(uint index, float4 raycast, float4 mask)
{
	rr_cacheR[index] = f32tof16(raycast.r) | f32tof16(mask.r) << 16;
	rr_cacheG[index] = f32tof16(raycast.g) | f32tof16(mask.g) << 16;
	rr_cacheB[index] = f32tof16(raycast.b) | f32tof16(mask.b) << 16;
	rr_cacheA[index] = f32tof16(raycast.a) | f32tof16(mask.a) << 16;
}

void LoadResolveData(uint index, out float4 raycast, out float4 mask)
{
	uint rr = rr_cacheR[index];
	uint gg = rr_cacheG[index];
	uint bb = rr_cacheB[index];
	uint aa = rr_cacheA[index];

	raycast = float4(f16tof32(rr), f16tof32(gg), f16tof32(bb), f16tof32(aa));
	mask = float4(f16tof32(rr >> 16), f16tof32(gg >> 16), f16tof32(bb >> 16), f16tof32(aa >> 16));
}

[numthreads(KERNEL_SIZE + RESOLVE_RAD2, KERNEL_SIZE + RESOLVE_RAD2, 1)]
void CSResolve(uint3 groupId : SV_GroupId, uint groupIndex : SV_GroupIndex, uint3 groupThreadId : SV_GroupThreadID)
{
	uint2 uvInt = (groupId.xy * KERNEL_SIZE) + groupThreadId.xy - RESOLVE_RAD;
	float2 uv = (uvInt.xy + 0.5) * _SR_ResolveSize.zw;

	float4 normalAndRoughness = SR_GetNormalAndRoughness(uv);
	float roughness = normalAndRoughness.w;
	float3 viewNormal = SR_GetViewNormal(normalAndRoughness.xyz);

	float depth = SR_GetRawDepth(uv);
	float3 viewPos = SR_GetViewPosition(uv, depth);

	float3 viewDir = normalize(viewPos);
	float NdotV = saturate(dot(viewNormal, -viewDir));

	float coneTangent = lerp(0.0, roughness * (1.0 - _SRBRDFBias), NdotV * sqrt(roughness));
	coneTangent *= lerp(saturate(NdotV * 2), 1, sqrt(roughness));

	float maxMipLevel = (float)_SRMaxMipMap - 1.0;
	float4 hitSourcePacked = _SRRayCastInput.SampleLevel(sampler_point_clamp, uv, 0);
	float sourceMip = clamp(log2(coneTangent * length(hitSourcePacked.xy - uv) * max(_SR_ScreenSize.x, _SR_ScreenSize.y)), 0.0, maxMipLevel);
	float4 maskAndColor = float4(_SRSceneColor.SampleLevel(sampler_linear_clamp, hitSourcePacked.xy, sourceMip).rgb,
	                             _SRRayCastMaskInput.SampleLevel(sampler_point_clamp, uv, 0).r);

	StoreResolveData(groupIndex, hitSourcePacked, maskAndColor);

	GroupMemoryBarrierWithGroupSync();

	bool border = groupThreadId.x < RESOLVE_RAD | groupThreadId.y < RESOLVE_RAD |
	              groupThreadId.x >= KERNEL_SIZE + RESOLVE_RAD || groupThreadId.y >= KERNEL_SIZE + RESOLVE_RAD;
	if (border)
		return;

	float4 result = 0.0;
	float weightSum = 0.0;
	float mul = _SR_ResolveSize.x / _SR_RayCastSize.x;

	[unroll]
	for (int i = 0; i < 4; i++)
	{
		int2 offsetUV = SR_Offset[i] * mul * 2;

		// "uv" is the location of the current (or "local") pixel. We want to resolve the local pixel using
		// intersections spawned from neighboring pixels.
		int2 neighborGroupThreadId = groupThreadId.xy + offsetUV;
		uint neighborIndex = neighborGroupThreadId.y * (KERNEL_SIZE + RESOLVE_RAD2) + neighborGroupThreadId.x;

		float4 hitPacked;
		float4 maskScreenPacked;
		LoadResolveData(neighborIndex, hitPacked, maskScreenPacked);

		float2 hitUv = hitPacked.xy;
		float hitZ = hitPacked.z;
		float hitPDF = hitPacked.w;
		float hitMask = maskScreenPacked.a;

		float3 hitViewPos = SR_GetViewPosition(hitUv, hitZ);

		// We assume that the hit point of the neighbor's ray is also visible for our ray, and we blindly pretend
		// that the current pixel shot that ray. To do that, we treat the hit point as a tiny light source.
		float weight = 1.0;
		if (_SRNormalization == 1)
		{
			float3 L = normalize(hitViewPos - viewPos);
			float NdotL = dot(viewNormal, L);

			// The BRDF weight is divided by the sampling pdf, which explodes for grazing hit directions
			// (the visibility term is almost 1 / 0). Such samples are both wrong and useless, so they are
			// dropped and the remaining weights are clamped to keep single samples from dominating.
			weight = NdotL > 0.0
				? BRDF_Unity_Weight(normalize(-viewPos) /*V*/, L /*L*/, viewNormal /*N*/, roughness) / max(1e-5, hitPDF)
				: 0.0;

			weight = clamp(weight, 1e-3, 64.0);
		}

		float4 sampleColor;
		sampleColor.rgb = maskScreenPacked.rgb;
		sampleColor.a = SR_RayAttenBorder(hitUv, _SREdgeFactor) * hitMask;

		// HDRP renders into an HDR buffer, so no firefly compression/uncompression is applied here:
		// the original LDR remap (x / (1 + lum) and its inverse) is invalid above 1 and produced NaN
		// and blown out pixels.
		result += sampleColor * weight;
		weightSum += weight;
	}

	result /= max(weightSum, 1e-5);

	_SRResolveResult[uvInt.xy] = max(1e-5, result);
}

// ---------------------------------------------------------------------------------------------
// Temporal reprojection, based on https://github.com/playdeadgames/temporal
// ---------------------------------------------------------------------------------------------
Texture2D<half4> _SRResolveInput;
RWTexture2D<half4> _SRTemporalResult;

groupshared uint t_cacheR[(KERNEL_SIZE + 2) * (KERNEL_SIZE + 2)];
groupshared uint t_cacheG[(KERNEL_SIZE + 2) * (KERNEL_SIZE + 2)];
groupshared uint t_cacheB[(KERNEL_SIZE + 2) * (KERNEL_SIZE + 2)];
groupshared uint t_cacheA[(KERNEL_SIZE + 2) * (KERNEL_SIZE + 2)];

void Store1TPixel(uint index, float4 pixel)
{
	t_cacheR[index] = asuint(pixel.r);
	t_cacheG[index] = asuint(pixel.g);
	t_cacheB[index] = asuint(pixel.b);
	t_cacheA[index] = asuint(pixel.a);
}

void Load1TPixel(uint index, out float4 pixel)
{
	pixel = asfloat(uint4(t_cacheR[index], t_cacheG[index], t_cacheB[index], t_cacheA[index]));
}

float4 clip_aabb(float3 aabb_min, float3 aabb_max, float4 p, float4 q)
{
	float3 p_clip = 0.5 * (aabb_max + aabb_min);
	float3 e_clip = 0.5 * (aabb_max - aabb_min) + SR_FLT_EPS;

	float4 v_clip = q - float4(p_clip, p.w);
	float3 v_unit = v_clip.xyz / e_clip;
	float3 a_unit = abs(v_unit);
	float ma_unit = max(a_unit.x, max(a_unit.y, a_unit.z));

	if (ma_unit > 1.0)
		return float4(p_clip, p.w) + v_clip / ma_unit;
	else
		return q; // point inside aabb
}

[numthreads(KERNEL_SIZE + 2, KERNEL_SIZE + 2, 1)]
void CSTemporal(uint3 groupId : SV_GroupId, uint3 groupThreadId : SV_GroupThreadID)
{
	uint2 uvInt = (groupId.xy * KERNEL_SIZE) + (groupThreadId.xy - 1);
	float2 uv = saturate((uvInt.xy + 0.5) * _SR_ResolveSize.zw);
	uint groupIndex = groupThreadId.y * (KERNEL_SIZE + 2) + groupThreadId.x;

	float4 current = _SRResolveInput.SampleLevel(sampler_linear_clamp, uv, 0);
	Store1TPixel(groupIndex, current);

	GroupMemoryBarrierWithGroupSync();

	bool border = groupThreadId.x == 0 | groupThreadId.y == 0 |
	              groupThreadId.x == KERNEL_SIZE + 1 || groupThreadId.y == KERNEL_SIZE + 1;
	if (border)
		return;

	// HDRP motion vectors are already expressed as a uv space delta.
	float2 velocity = SR_GetMotionVector(uv);
	float2 prevUV = uv - velocity;

	float4 previous;
	if (any(prevUV < 0.0) || any(prevUV > 1.0))
		previous = current;
	else
		previous = _SRPreviousTemporal.SampleLevel(sampler_linear_clamp, prevUV, 0);

	half4 currentMin = 100;
	half4 currentMax = 0;
	half4 currentAverage = 0;

	[unroll]
	for (int i = 0; i < 9; i++)
	{
		uint2 offsetUV = groupThreadId.xy + SR_Offset[i];
		float4 val;
		Load1TPixel(offsetUV.y * (KERNEL_SIZE + 2) + offsetUV.x, val);
		currentMin = min(currentMin, val);
		currentMax = max(currentMax, val);
		currentAverage += val;
	}

	currentAverage /= 9.0;

	previous = clip_aabb(currentMin.xyz, currentMax.xyz, clamp(currentAverage, currentMin, currentMax), previous);

	float lum0 = SR_Luminance(current.rgb);
	float lum1 = SR_Luminance(previous.rgb);

	float unbiased_diff = abs(lum0 - lum1) / max(lum0, max(lum1, 0.2));
	float unbiased_weight = 1.0 - unbiased_diff;
	float unbiased_weight_sqr = unbiased_weight * unbiased_weight;
	float k_feedback = lerp(_SRTResponseMin, _SRTResponseMax, unbiased_weight_sqr);

	_SRTemporalResult[uvInt.xy] = lerp(current, previous, k_feedback);
}
